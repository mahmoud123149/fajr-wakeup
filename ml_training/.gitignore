# ---------------------------------------------------------------------------
# Fajr WakeUp - ml_training/.gitignore
# ---------------------------------------------------------------------------

# Training outputs (models, metrics, plots) - regenerated by the scripts.
artifacts/

# Python caches / build
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/

# Dataset IMAGES are personal and large: do NOT commit them,
# but DO keep the directory structure (the .gitkeep files stay tracked
# because only image extensions are ignored here).
dataset/**/*.jpg
dataset/**/*.jpeg
dataset/**/*.png
dataset/**/*.webp
dataset/**/*.bmp
dataset/**/*.gif

# OS / editor noise
.DS_Store
Thumbs.db
